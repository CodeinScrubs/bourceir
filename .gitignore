# ============================================
# BRS Data Engine - فایل‌های نادیده‌گرفته توسط گیت
# ============================================

# پایتون - فایل‌های کامپایل‌شده
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# محیط مجازی پایتون
venv/
venv-*/
env/
.venv/
.env

# پایگاه داده
*.db
*.sqlite
*.sqlite3

# پوشه‌های داده و لاگ (محتوا نادیده گرفته می‌شود اما پوشه‌ها نگه‌داشته می‌شوند)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# IDE و ویرایشگرها
.idea/
.vscode/
*.swp
*.swo
*~

# سیستم‌عامل
Thumbs.db
.DS_Store
desktop.ini

# فایل‌های فشرده و خروجی‌های موقت
*.zip
*.tar.gz
*.rar

# توزیع و پکیج
dist/
build/
*.egg-info/
*.egg

# تست و پوشش کد
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebook
.ipynb_checkpoints/

# متفرقه
*.log
*.bak
*.tmp

# Streamlit secrets
.streamlit/secrets.toml

# تنظیمات شخصی Claude Code (فایل‌های مشترک مثل launch.json ثبت می‌شوند)
.claude/settings.local.json

# گزارش عیب‌یاب CI
doctor-ci.json
